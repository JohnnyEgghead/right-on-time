# F-96: the own copy's database password, a PUBLISHED, NON-SECRET default (as SPECIFICATIONS 11.1
# publishes SAMPLE_PASSWORD_SEED's own-copy value). infra/compose.yaml reads this file first for the
# db, migrate and setup services; the hosted server's /etc/brightwater/db.env (DB_ENV_FILE) is read
# after it and overrides it. The database is never published on a host port, and each process signs
# in with its own generated login password (F-150), so this value only opens the db container's
# own superuser on a machine you already control. Change it here, or set DB_ENV_FILE to your own file.
POSTGRES_PASSWORD=own-copy-example-default
