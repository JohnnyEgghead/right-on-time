# The demo profile (SPECIFICATIONS SD-3, section 11.1 "Hosted demo" column): the hosted demo's
# non-secret settings. infra/deploy/deploy.sh --profile demo adds this file to the server's .env;
# the secrets (ACCESS_CODE and the rest) never live here (NFR-14). Checked against the
# SPECIFICATIONS table by infra/tests/compose.test.ts.
APP_ORIGIN=https://bw.j7l.io
TEXT_LINK_HOST=bw.j7l.io
DEMO_MODE=on
ACCESS_CODE_ON=on
RESET_PROTECTION=on
NIGHTLY_RESET=on
IDLE_RESET_MINUTES=120
RESET_COOLDOWN_SECONDS=300
SOURCE_REPO_URL=https://github.com/JohnnyEgghead/right-on-time
PHOTOS_DIR=/data/photos
LOG_LEVEL=info
# F-1696: the hosted words of the System health page locations (section 11.1, FR-HLTH-2).
DATA_LOCATION_APP=AWS Lightsail, US East (Virginia)
DATA_LOCATION_BACKUPS=AWS Lightsail object storage, US East (Virginia)
DATA_LOCATION_TEXTS=AWS Lightsail, US East (Virginia)
DATA_LOCATION_MAPS=AWS Lightsail, US East (Virginia)
