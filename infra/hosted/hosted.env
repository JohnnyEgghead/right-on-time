# P1-DEPLOY: the hosted server's own switches (bw.j7l.io). infra/deploy/deploy.sh writes the
# server's /opt/brightwater/.env from this file (plus the demo profile when asked, plus ROUTES,
# BW_MAPS_DIR and BW_IMAGE), so every plain "docker compose" there (certbot-renew.sh too) sees the same values.
# F-1645: no ROUTES line here (the deploy stops on one). deploy.sh writes ROUTES from the deploy mode:
# open only for "--release <tag> --profile demo" (P8-UNLOCK), locked for every other deploy and drill.
# F-1648: a BW_MAPS_DIR line here (none by default: /opt/.build/data/maps) is the map folder of both deploy halves and Compose.
PROXY_CONF=hosted.conf
HTTP_BIND=80
HTTPS_BIND=443
# P3-BACKUP: backups on (SPECIFICATIONS 11.1, 4.8): the Lightsail bucket of spike S5, in the server's Region
# (docs/build/spikes/G-S5-HOST.md; us-east-1, D1-LOCK). The instance reaches it by resource access: no key here.
BACKUP_TARGET=lightsail
BACKUP_BUCKET=brightwater-backup-use1
BACKUP_REGION=us-east-1
# P6-ROUTING-MEMORY (BUILD_PLAN section 3 D-21, owner answer 8936427c): the routing service's cap on small_3_0, the cap measured there
# (docs/build/spikes/P6-ROUTING-MEMORY.md). infra/compose.yaml's default is the local copies' own measured cap.
ROUTING_MEM_LIMIT=320m
