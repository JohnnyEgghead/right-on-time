#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# pre-push — FAST GUARD ONLY. Runs no tests, no CI. Target: well under a second.
# jl-bc-body-sha256: e69c3563bbda8bfbea7cea5e5fd5124268caabab744738e346ceef8515bc9f81
#   ^ sha256 of this file with that one line removed. build-continuity install.sh overwrites an
#   installed copy ONLY when the copy's own body hash matches its recorded line (or, for a copy
#   from 0.4.16 or earlier that has no line, when it is byte-identical to that legacy template).
#   A project edit inside this file therefore SURVIVES every install (0.4.17, REC-DN-5: the
#   0.4.13..0.4.16 installers overwrote any copy carrying the FAST GUARD ONLY marker, which
#   silently reverted an owner-ruled allowlist in one project). Editing this template? Regenerate
#   the line:  grep -v '^# jl-bc-body-sha256:' pre-push | shasum -a 256
#
# WHY ONLY THIS ONE CLASS
# A pre-push hook that runs the test suite is a tax on the safest possible habit. Pushing
# becomes expensive, so deferring the push becomes the path of least resistance — and the
# work ends up existing on exactly one disk. That is not hypothetical: one project measured
# 10+ minutes and ~36% CPU to push two shell scripts, and ended up with 6 commits of real
# work on a single local branch with no remote copy at all. A gate too expensive to run gets
# routed around, and the routing around is the failure.
#
# So this hook blocks exactly ONE class: a secret reaching the remote. Everything else a push
# can get wrong is cheap to fix forward with another commit. A leaked credential is not —
# removing it needs a history rewrite, which requires explicit owner confirmation and is never
# bundled with other work. The only blocking check is the one whose damage is irreversible,
# and it costs milliseconds.
#
# Test failures deliberately do NOT block. Pushing broken work-in-progress to a private repo
# is safe and often correct; SHIPPING it unverified is not, and that belongs at a task/wave
# boundary gate, not here.
set -uo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT" || exit 1

FAIL=0

# --- 1. a real .env must never be tracked (.env.example is fine) ---
# NOTE: deliberately NOT `git diff --cached`. At pre-push time the index is normally clean —
# you just committed — so a staged-file check reads as protection it does not provide.
TRACKED_ENV=$(git ls-files | grep -E '(^|/)\.env$' || true)
if [ -n "$TRACKED_ENV" ]; then
  echo "BLOCKED: a real .env is TRACKED in this repo:"
  printf '%s\n' "$TRACKED_ENV" | sed 's/^/    /'
  FAIL=1
fi

# --- 2. scan the OUTGOING commits for credentials ---
# Scoped to what is actually being pushed. Ranges arrive on stdin as:
#   <local ref> <local sha> <remote ref> <remote sha>
# A remote sha of all-zeros means a brand-new branch; an all-zeros local sha is a deletion.
#
# Scan ONLY commits that are on no remote, for EVERY pushed ref, new branch or existing (F-42,
# upstreamed from Chrome-to-Claude 6624bde6; WISDOM candidate C-288). The outgoing set is
#   git log <every pushed sha> --not --remotes <every replaced remote sha known locally>
# Why not rsha..lsha: that re-scans history already published on ANOTHER remote branch.
# Pushing a branch onto a main ~2000 commits behind re-scanned it and blocked on base64 font
# data. A ref whose commits are all already on a remote has nothing new to scan.
#
# Each outgoing commit is scanned on its own, not the push as one endpoint diff (F-3455).
# Every commit reaches the remote, so a value added in one commit and deleted in the next
# is still in its history. The pre-F-3455 scan diffed only base..lsha, and its fallbacks
# failed open: several refs in one push gave "git diff A..B C..D", a usage error swallowed
# by 2>/dev/null, and a first push with no remote-tracking ref diffed the commit against
# the working tree. Any failure of the scan below refuses the push instead.
ZERO='0000000000000000000000000000000000000000'
PUSHED=()
KNOWN=()
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue                       # branch deletion
  PUSHED+=("$lsha")
  if [ "${rsha:-$ZERO}" != "$ZERO" ] && git rev-parse -q --verify "$rsha^{commit}" >/dev/null 2>&1; then
    KNOWN+=("$rsha")
  fi
done

# The content scan. Input: "git log -p --cc" with --format="commit %H". Output: one line per
# finding, "<path>:<line>: <key or detector> (commit <sha>)". It never prints a value.
#
# A finding is an added line where a credential-named KEY is assigned a non-trivial VALUE,
# in any of these spellings, in any path:
#   NAME=value   NAME = value   NAME => value (launchctl print)   "NAME": "value" (JSON)
#   NAME: value (YAML)   export NAME=value   and so inside a launchctl/env/printenv dump.
# KEY: split at _ - . and camelCase; its LAST word ends in token, secret, password or bearer,
#   or is api+key / private+key, or is hash/key/value/b64/base64/hex/raw after such a word
#   (RELAY_PAIRING_BOOTSTRAP_TOKEN_HASH). Not credentials: TOKEN_PATH, tokenFile, tokens.
# VALUE: the quoted string, or the unquoted run up to a space or , ; ) } ] = &. Trivial,
#   and so passed: under 8 characters; one repeated character, separators aside (the F-2930
#   fixture form, "x".repeat(40)); <redacted>, ***, ${...}, $VAR, $(cmd), --css-var, or a
#   value containing changeme, example, redacted, placeholder, replace, your-, your_ or
#   "..." (the .env.example idiom: your-key-here, replace-me); a number or a timestamp;
#   an UPPER_SNAKE env-var name, a digit-free a.b.c member chain or a letters-only
#   camelCase word; a value holding ( ) [ ] { } < > , ; or a quote (code, not a secret); a
#   quoted value of 3+ words (prose). A value of plain words joined by dashes is NOT
#   trivial: a human-chosen credential takes that shape, so a fixture must not (F-2930).
# Code files (ts js py go ...): an UNQUOTED value after ":" or a spaced "=" is an
#   expression, not a value. "NAME=value" unspaced and "NAME => value" are still scanned.
# Prose (bc 0.4.40, OWED 293): an UNQUOTED letters-only word followed by more text on the
#   line ("New token: Graphite / ghost / text" in a test log) is a sentence, not a value.
# Also, outside *.example / *.lock: sk-ant-, sk-, AIza and AKIA key shapes and PEM private
#   key headers (the pre-F-3455 detectors, unchanged).
# Not seen: files git treats as binary; the identity of a credential with no named key.
# shellcheck disable=SC2016  # an awk program: its $0, $2 are awk fields, not shell expansions
SCAN_AWK='
BEGIN {
  SQ = sprintf("%c", 39)
  CAND = "[A-Za-z_][A-Za-z0-9_.-]*[\"" SQ "`]?[ \t]*(=>|=|:)"
  VALRUN = "^[^] \t,;)}=&\"" SQ "`]*"
  NOTCRED = "[][(){}<>,;`\"" SQ "]"
  ENVNAME = "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$"
  CAMEL = "^[A-Za-z][a-z]+([A-Z][a-z]+)+$"
  MEMBER = "^[#A-Za-z_$][A-Za-z0-9_$]*([.][#A-Za-z_$][A-Za-z0-9_$]*)+$"
  STAMP = "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]([T ][0-9:.]+)?(Z|[+-][0-9:]+)?$"
  EXPR = "[.](ts|tsx|mts|cts|js|jsx|mjs|cjs|py|go|rs|java|kt|swift|c|h|cc|cpp|cs|rb|php|lua|vue|svelte)$"
  MINLEN = 8
}
function credname(k,   i, c, p, w, n, a, j) {
  w = ""; p = ""
  for (i = 1; i <= length(k); i++) {
    c = substr(k, i, 1)
    if (c ~ /[A-Z]/ && p ~ /[a-z0-9]/) w = w "_"
    w = w ((c ~ /[.-]/) ? "_" : c); p = c
  }
  n = split(tolower(w), a, "_")
  while (n > 1 && (a[n] == "" || a[n] ~ /^[0-9]+$/)) n--
  if (a[n] ~ /(token|secret|password|bearer|apikey|privatekey)$/) return 1
  if (n > 1 && a[n] == "key" && a[n - 1] ~ /^(api|private)$/) return 1
  if (a[n] ~ /^(hash|key|value|b64|base64|hex|raw)$/)
    for (j = 1; j < n; j++) if (a[j] ~ /(token|secret|password|bearer)$/) return 1
  return 0
}
function value(r,   q, e) {
  sub(/^[ \t]+/, "", r)
  q = substr(r, 1, 1); UNTERM = 0
  if (q == "\"" || q == SQ || q == "`") {
    QUOTED = 1
    r = substr(r, 2); e = index(r, q)
    if (!e) { UNTERM = 1; return "" }
    return substr(r, 1, e - 1)
  }
  QUOTED = 0
  match(r, VALRUN)
  return substr(r, 1, RLENGTH)
}
function trivialword(v,   t, c, i) {
  if (v ~ /@[A-Za-z0-9-]+[.][A-Za-z0-9.-]*[A-Za-z]/) { v = substr(v, 1, index(v, "@") - 1); sub(/^.*:/, "", v) }
  if (length(v) < MINLEN) return 1
  if (v ~ NOTCRED || v ~ /^([$%]|--)/) return 1
  if (tolower(v) ~ /changeme|example|redacted|placeholder|replace|your[-_]/ || index(v, "...")) return 1
  if (v ~ /^[0-9][0-9,._:\/]*[A-Za-z%]?$/ || v ~ STAMP) return 1
  t = v; gsub(/[-_.:\/]/, "", t)
  if (t == "") return 1
  c = substr(t, 1, 1)
  for (i = 2; i <= length(t); i++) if (substr(t, i, 1) != c) break
  if (i > length(t)) return 1
  if (v ~ ENVNAME || v ~ CAMEL || (v ~ MEMBER && v !~ /[0-9]/)) return 1
  return 0
}
function trivial(v,   n, w, i) {
  if (UNTERM || v ~ /^[$]/) return 1
  if (v !~ /[ \t]/) return trivialword(v)
  n = split(v, w, /[ \t]+/)
  if (n >= 3) return 1
  for (i = 1; i <= n; i++) if (!trivialword(w[i])) return 0
  return 1
}
function prose(r, v,   after) {
  sub(/^[ \t]+/, "", r)
  after = substr(r, length(v) + 1)
  return after ~ /^[ \t]+[^ \t#]/
}
function hit(what) {
  printf "%s:%d: %s (commit %s)\n", path, ln, what, substr(commit, 1, 12)
}
function scanline(body,   s, lb, t, key, sep, rest, v, guard) {
  lb = tolower(body)
  if (path !~ /[.](example|lock)$/) {
    if (lb ~ /sk-ant-[a-z0-9_-]{20,}/) hit("sk-ant- key")
    else if (lb ~ /sk-[a-z0-9]{32,}/) hit("sk- key")
    if (lb ~ /aiza[a-z0-9_-]{30,}/) hit("AIza key")
    if (lb ~ /akia[0-9a-z]{16}/) hit("AKIA key")
    if (lb ~ /-----begin [a-z ]*private key-----/) hit("PEM private key block")
  }
  s = body
  # 0.4.41 (F-3518): a backslash escape sequence (a literal \n, \r or \t in a transcript, .jsonl or
  # .diff) is a SEPARATOR, so "...token\nbearer:" is two words, not the key "tokennbearer". Every
  # other backslash (an escaped quote, a line-continuation tail) is still dropped.
  gsub(/\\[nrt]/, " ", s)
  gsub(/\\/, "", s)
  guard = 0
  while (guard++ < 64 && match(s, CAND)) {
    t = substr(s, RSTART, RLENGTH)
    rest = substr(s, RSTART + RLENGTH)
    s = rest
    match(t, /^[A-Za-z_][A-Za-z0-9_.-]*/); key = substr(t, 1, RLENGTH)
    sep = substr(t, length(t), 1)
    if (sep == "=" && rest ~ /^[=~]/) continue
    if (!credname(key)) continue
    v = value(rest)
    if (path ~ EXPR && !QUOTED && (sep == ":" || (rest ~ /^[ \t]/ && t ~ /[ \t]=$/))) continue
    if (trivial(v)) continue
    if (!QUOTED && v ~ /^[A-Za-z]+$/ && prose(rest, v)) continue
    hit(key)
  }
}
/^commit [0-9a-f]+$/ { commit = $2; mode = ""; next }
/^diff / { mode = "hdr"; path = ""; next }
/^@@/ {
  np = 0; while (substr($0, np + 1, 1) == "@") np++
  np--
  match($0, /[+][0-9]+/); ln = substr($0, RSTART + 1, RLENGTH - 1) + 0
  mode = "hunk"; next
}
mode == "hdr" && /^[+][+][+] / {
  path = substr($0, 5); sub(/\t$/, "", path); sub(/^"/, "", path); sub(/"$/, "", path); sub(/^b\//, "", path)
  next
}
mode == "hunk" {
  if (substr($0, 1, 1) == "\\") next
  pre = substr($0, 1, np)
  if (pre ~ /-/) next
  if (pre ~ /[+]/) scanline(substr($0, np + 1))
  ln++
}
'

if [ "${#PUSHED[@]}" -gt 0 ]; then
  OUTGOING=("${PUSHED[@]}" --not --remotes ${KNOWN[@]+"${KNOWN[@]}"})

  # A .env added anywhere in the outgoing commits, even if later deleted and so not "tracked"
  # at HEAD. Not redundant with the content scan below: a .env whose values are short
  # (DB_PASSWORD=hunter2) is under the length floor that scan uses.
  if NAMES=$(git log --format= --name-only --diff-filter=ACMRT "${OUTGOING[@]}" --); then
    ENV_IN_RANGE=$(printf '%s\n' "$NAMES" | grep -E '(^|/)\.env$' | sort -u || true)
    if [ -n "$ENV_IN_RANGE" ]; then
      echo "BLOCKED: a .env file appears in the outgoing commits:"
      printf '%s\n' "$ENV_IN_RANGE" | sed 's/^/    /'
      FAIL=1
    fi
  else
    echo "BLOCKED: could not list the files in the outgoing commits (git log failed)."
    FAIL=1
  fi

  # LC_ALL=C: a UTF-8 awk aborts on the first invalid byte, which would end the scan early.
  HITS=$(git log -p --cc -M -U0 --no-color --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/ \
           --format='commit %H' "${OUTGOING[@]}" -- | LC_ALL=C awk "$SCAN_AWK")
  SCAN_RC=$?
  if [ "$SCAN_RC" -ne 0 ]; then
    echo "BLOCKED: the credential scan of the outgoing commits did not complete (exit $SCAN_RC)."
    echo "  Refusing rather than pushing commits nobody scanned."
    FAIL=1
  elif [ -n "$HITS" ]; then
    NHITS=$(printf '%s\n' "$HITS" | wc -l | tr -d ' ')
    echo "BLOCKED: credential assignment(s) in the outgoing commits (file:line: key; values not shown):"
    printf '%s\n' "$HITS" | sed -n '1,20p' | sed 's/^/    /'
    [ "$NHITS" -gt 20 ] && echo "    ... and $((NHITS - 20)) more"
    echo "  The value is in a commit, not only the tree: remove it from those commits before pushing."
    echo "  Test fixtures: write a fake token as one repeated character (F-2930), e.g. \"x\".repeat(40)."
    echo "  If this is a false positive: git push --no-verify"
    FAIL=1
  fi
fi

[ "$FAIL" -eq 1 ] && exit 1

# --- 3. non-blocking: report verification debt if this project tracks it ---
if [ -x ./scripts/ci.sh ]; then
  ./scripts/ci.sh --status 2>/dev/null | sed 's/^/  /'
fi
exit 0
