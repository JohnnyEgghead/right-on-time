{
  "name": "brightwater-right-on-time",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mockups": "node mockups/tools/build.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "bash ci/ci.sh",
    "setup": "node packages/setup/src/cli.ts",
    "setup:maps": "node packages/maps/src/cli.ts fetch",
    "prepare": "node -e \"const f='packages/i18n/scripts/register-merge-driver.ts';if(require('fs').existsSync(f))require('child_process').execFileSync('node',[f],{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "intl-messageformat": "12.1.3",
    "jscpd": "5.4.3",
    "knip": "6.45.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
